#!/bin/sh
set -e

if ! getent passwd admin > /dev/null; then
    echo "Creating admin user..."
    useradd -m -d /home/admin -s /bin/rbash -U admin
    chmod 750 /home/admin
    usermod --append --groups admin nagios
  else
   echo "The admin user already exists.."
fi

case "$1" in
  configure)
    if [ ! -L /etc/cron.daily/backup_etc ]; then
      echo "Create symbolic link for /etc/cron.daily/backup_etc..."
      ln --force --symbolic /usr/sbin/backup_etc /etc/cron.daily/backup_etc
    fi

    if [ ! -L /etc/cron.daily/backup_home ]; then
      echo "Create symbolic link for /etc/cron.daily/backup_home..."
      ln --force --symbolic /usr/sbin/backup_home /etc/cron.daily/backup_home
    fi

    if [ ! -L /etc/cron.daily/backup_tape ]; then
      echo "Create symbolic link for /etc/cron.daily/backup_tape..."
      ln --force --symbolic /usr/sbin/backup_tape /etc/cron.daily/backup_tape
    fi

    if [ ! -L /etc/cron.daily/remote_backup_sync ]; then
      echo "Create symbolic link for /etc/cron.daily/remote_backup_sync..."
      ln --force --symbolic /usr/sbin/remote_backup_sync /etc/cron.daily/remote_backup_sync
    fi

    if [ ! -L /etc/cron.daily/mysqldump ]; then
      echo "Create symbolic link for /etc/cron.daily/mysqldump..."
      ln --force --symbolic /usr/sbin/backup_mysql /etc/cron.daily/backup_mysql
    fi

    if [ ! -L /etc/cron.daily/pg_dump ]; then
      echo "Create symbolic link for /etc/cron.daily/pg_dump..."
      ln --force --symbolic /usr/sbin/backup_postgresql /etc/cron.daily/backup_postgresql
    fi

    if [ ! -L /etc/cron.monthly/backup_raiz ]; then
      echo "Create symbolic link for /etc/cron.monthly/backup_raiz..."
      ln --force --symbolic /usr/sbin/backup_raiz /etc/cron.monthly/backup_raiz
    fi

    if [ ! -L /etc/cron.weekly/backup_libvirt ]; then
      echo "Create symbolic link for /etc/cron.weekly/backup_libvirt..."
      ln --force --symbolic /usr/sbin/backup_libvirt /etc/cron.weekly/backup_libvirt
    fi

    if [ ! -d /usr/lib64/nagios/plugins ]; then
      echo "Create directory /usr/lib64/nagios/plugins..."
      mkdir -p /usr/lib64/nagios/plugins
    fi

    if [ ! -L /usr/lib64/nagios/plugins/check_backup-cron ]; then
      echo "Create symbolic link for /usr/lib64/nagios/plugins/check_backup-cron..."
      ln --force --symbolic /usr/lib/nagios/plugins/check_backup-cron /usr/lib64/nagios/plugins/check_backup-cron
    fi

    if [ -f /etc/backup-cron/backup-cron.conf ]; then
      echo "Configuring backup-cron for Debian-based systems..."
      sed -i 's/tmpwatch/tmpreaper/g' /etc/backup-cron/backup-cron.conf
    fi

    ;;
esac

exit 0

